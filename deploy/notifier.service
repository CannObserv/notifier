[Unit]
Description=Notifier — multi-tenant notifications service
After=network.target postgresql.service tailscaled.service

# The service binds this host's tailnet address alone (#43 D3), so a start that
# beats tailscaled to an address cannot bind at all. After= orders the two but
# does not wait for the address — scripts/tailnet_bind.sh does that, and gives
# up non-zero rather than falling back to a bind reachable from elsewhere.
#
# Which means every failed start now costs the full tailnet wait *before*
# RestartSec begins. systemd's default StartLimitIntervalSec is 10s, far too
# short to ever count restarts that far apart, so without an explicit bound a
# genuinely broken configuration would retry forever — the same silently-dead
# endpoint notifier-dev.service bounds itself against, arriving by a different
# route. 5 tries x (60s wait + 5s) = ~325s of retries inside a 900s window:
# long enough to ride out tailscaled and Postgres at boot, short enough that a
# real misconfiguration gives up somewhere a human will see it.
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=simple
User=exedev
WorkingDirectory=/home/exedev/notifier

# Create runtime dir (runs as root before User= takes effect with + prefix)
ExecStartPre=+/bin/bash -c 'mkdir -p /run/notifier && chown exedev:exedev /run/notifier'

# Write current git SHA to a runtime env file before starting
ExecStartPre=/bin/bash -c 'echo BUILD_ID=$(git rev-parse --short HEAD) > /run/notifier/build-id'

# The production database opt-in for src/core/db_safety.py. This MUST stay in
# the unit and never move into an EnvironmentFile below — anything in those
# files is inherited by every shell that sources them, which would re-open the
# hole for exactly the hand-run servers the guard targets (issue #22).
Environment=NOTIFIER_ALLOW_PROD_DB=1

# Load BUILD_ID, then system secrets, then optional repo-local overrides
EnvironmentFile=-/run/notifier/build-id
EnvironmentFile=/etc/notifier/.env
EnvironmentFile=-/home/exedev/notifier/.env

# Never a uvicorn line here. Besides the one-spelling rule notifier-dev.service
# has held since #24, systemd reads every EnvironmentFile= *before* ExecStartPre
# runs — so no ExecStartPre can resolve this host's tailnet address into the
# environment ExecStart would see. Resolving and binding must share a process.
ExecStart=/home/exedev/notifier/scripts/serve.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
